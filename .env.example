# Server
PORT=3002
NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://ayncor:ayncor@localhost:54322/core_service?schema=public

# Redis (for outbox relay → realtime-gateway)
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=realtime:events
# Optional relay tuning (defaults: 500, 100)
# RELAY_POLL_MS=500
# RELAY_BATCH_SIZE=100

RELAY_POLL_MS=500
RELAY_BATCH_SIZE=100

# Auth (validated locally for now; later move to JWKS / key rotation)
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900

