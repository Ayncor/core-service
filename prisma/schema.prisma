generator client {
  provider = "prisma-client"
  // Prisma ORM v7 requires explicit output (no longer generated into node_modules).
  // This path is relative to this schema file (`prisma/schema.prisma`).
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelVisibility {
  ORG
  PRIVATE
}

enum ThreadState {
  OPEN
  BLOCKED
  DECIDED
  ARCHIVED
}

enum Urgency {
  NORMAL
  URGENT
}

enum ThreadParticipantRole {
  OWNER
  PARTICIPANT
  OBSERVER
}

enum ThreadUserStatus {
  IN_INBOX
  ARCHIVED
  SNOOZED
}

enum PriorityOverride {
  NONE
  LOW
  HIGH
}

enum MessageKind {
  TEXT
  SYSTEM
}

enum MessageFormat {
  PLAIN
  MARKDOWN
}

model Channel {
  id         String            @id @default(uuid()) @db.Uuid
  orgId      String            @db.Uuid
  name       String
  slug       String
  visibility ChannelVisibility @default(ORG)

  createdByUserId String? @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?

  threads Thread[]

  @@unique([orgId, slug])
  @@index([orgId, createdAt])
}

model Thread {
  id        String      @id @default(uuid()) @db.Uuid
  orgId     String      @db.Uuid
  channelId String      @db.Uuid
  state     ThreadState @default(OPEN)

  title   String
  purpose String?

  createdByUserId       String?   @db.Uuid
  createdByMembershipId String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastActivityAt        DateTime  @default(now())
  archivedAt            DateTime?

  channel          Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages         Message[]
  participants     ThreadParticipant[]
  userStates       ThreadUserState[]

  @@index([orgId, createdAt])
  @@index([channelId, createdAt])
  @@index([orgId, lastActivityAt])
}

model Message {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @db.Uuid
  threadId String  @db.Uuid

  authorUserId       String?      @db.Uuid
  authorMembershipId String?      @db.Uuid

  kind            MessageKind @default(TEXT)
  urgency         Urgency     @default(NORMAL)
  requiresResponse Boolean     @default(false)
  replyToMessageId String?    @db.Uuid
  metadataJson     Json        @default("{}")

  createdAt DateTime @default(now())
  deletedAt DateTime?
  deletedBy String?  @db.Uuid

  thread   Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  versions MessageVersion[]
  reactions Reaction[]

  @@index([orgId, createdAt])
  @@index([threadId, createdAt])
}

model MessageVersion {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @db.Uuid
  messageId String        @db.Uuid
  version   Int           // Starts at 1, increments by 1
  body      String
  format    MessageFormat @default(MARKDOWN)
  createdAt DateTime      @default(now())

  editorUserId String? @db.Uuid

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([orgId, messageId, version])
  @@index([messageId, createdAt])
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  messageId String   @db.Uuid
  emoji     String

  actorUserId       String? @db.Uuid
  actorMembershipId String? @db.Uuid

  createdAt DateTime @default(now())
  removedAt DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([orgId, createdAt])
}

model ThreadParticipant {
  id        String                @id @default(uuid()) @db.Uuid
  orgId     String                @db.Uuid
  threadId  String                @db.Uuid
  userId    String                @db.Uuid
  role      ThreadParticipantRole @default(PARTICIPANT)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?
  mutedUntil DateTime?

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([orgId, threadId, userId])
  @@index([orgId, threadId])
  @@index([userId, joinedAt])
}

model ThreadUserState {
  id                String           @id @default(uuid()) @db.Uuid
  orgId             String           @db.Uuid
  threadId          String           @db.Uuid
  userId            String           @db.Uuid
  status            ThreadUserStatus @default(IN_INBOX)
  needsResponse     Boolean          @default(false)
  snoozedUntil      DateTime?
  lastReadMessageId String?         @db.Uuid
  lastReviewedAt   DateTime?
  priorityOverride  PriorityOverride @default(NONE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([orgId, threadId, userId])
  @@index([orgId, userId, status])
  @@index([orgId, userId, needsResponse])
  @@index([threadId])
}

