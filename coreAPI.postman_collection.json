{
  "info": {
    "_postman_id": "ayncor-core-service-api",
    "name": "Ayncor Core Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API documentation for core-service: channels, threads, messages, reactions, participants, inbox, user-state. Use baseUrl http://localhost:3002 for local dev. All endpoints require Bearer token (JWT from identity-service). Org and user are taken from JWT."
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check."
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Readiness check (DB connectivity)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "Create Channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"General\",\n  \"slug\": \"general\",\n  \"visibility\": \"ORG\",\n  \"description\": \"General channel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "channels"
              ]
            },
            "description": "Create channel. Visibility: ORG, PRIVATE."
          },
          "response": []
        },
        {
          "name": "List Channels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "channels"
              ]
            },
            "description": "List channels for org (from JWT)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Threads",
      "item": [
        {
          "name": "Create Thread",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel_id\": \"{{channelId}}\",\n  \"title\": \"Thread title\",\n  \"purpose\": \"Optional purpose\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/threads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads"
              ]
            },
            "description": "Create thread in channel."
          },
          "response": []
        },
        {
          "name": "List Threads in Channel",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/threads/channel/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "channel",
                "{{channelId}}"
              ]
            },
            "description": "List threads in channel."
          },
          "response": []
        },
        {
          "name": "Transition Thread State",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "state"
              ]
            },
            "description": "Transition thread state. State: OPEN, BLOCKED, DECIDED, ARCHIVED."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Participants",
      "item": [
        {
          "name": "Add Participant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"role\": \"PARTICIPANT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/participants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "participants"
              ]
            },
            "description": "Add participant to thread. Role: OWNER, PARTICIPANT, OBSERVER."
          },
          "response": []
        },
        {
          "name": "List Participants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/participants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "participants"
              ]
            },
            "description": "List participants in thread."
          },
          "response": []
        },
        {
          "name": "Update Participant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"OBSERVER\",\n  \"muted_until\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/participants/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "participants",
                "{{userId}}"
              ]
            },
            "description": "Update participant (role, muted_until)."
          },
          "response": []
        },
        {
          "name": "Remove Participant",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/participants/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "participants",
                "{{userId}}"
              ]
            },
            "description": "Remove participant from thread."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User State",
      "item": [
        {
          "name": "Get User State",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/user-state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "user-state"
              ]
            },
            "description": "Get current user's thread workflow state (get-or-create)."
          },
          "response": []
        },
        {
          "name": "Update User State",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_INBOX\",\n  \"needs_response\": true,\n  \"snoozed_until\": null,\n  \"last_read_message_id\": null,\n  \"last_reviewed_at\": null,\n  \"priority_override\": \"NONE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/threads/{{threadId}}/user-state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "threads",
                "{{threadId}}",
                "user-state"
              ]
            },
            "description": "Update user's thread state. Status: IN_INBOX, ARCHIVED, SNOOZED. If SNOOZED, snoozed_until required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inbox",
      "item": [
        {
          "name": "Get Inbox",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inbox?limit=50&cursor=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inbox"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": ""
                }
              ]
            },
            "description": "Get per-user async inbox (review queue). Server-ordered. Only threads with status IN_INBOX."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Create Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thread_id\": \"{{threadId}}\",\n  \"body\": \"Hello world\",\n  \"kind\": \"TEXT\",\n  \"urgency\": \"NORMAL\",\n  \"requires_response\": false,\n  \"reply_to_message_id\": null,\n  \"metadata_json\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages"
              ]
            },
            "description": "Create message. Kind: TEXT, SYSTEM. Urgency: NORMAL, URGENT."
          },
          "response": []
        },
        {
          "name": "List Messages in Thread",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages/thread/{{threadId}}?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages",
                "thread",
                "{{threadId}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (default 50, max 200). Newest messages first."
                },
                {
                  "key": "cursor",
                  "value": "{{messageListCursor}}",
                  "description": "Opaque next_cursor from previous response; omit on first page.",
                  "disabled": true
                }
              ]
            },
            "description": "Cursor-based pagination: newest first. Repeat with cursor={{next_cursor}} from the response to load older messages (infinite scroll). next_cursor omitted on last page."
          },
          "response": []
        },
        {
          "name": "Create Message Version (Edit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Updated message body\",\n  \"format\": \"PLAIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/messages/{{messageId}}/versions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages",
                "{{messageId}}",
                "versions"
              ]
            },
            "description": "Create new message version (edit). Format: PLAIN, MARKDOWN."
          },
          "response": []
        },
        {
          "name": "List Message Versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages/{{messageId}}/versions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages",
                "{{messageId}}",
                "versions"
              ]
            },
            "description": "List versions of a message (newest first)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reactions",
      "item": [
        {
          "name": "Toggle Reaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_id\": \"{{messageId}}\",\n  \"emoji\": \"👍\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reactions"
              ]
            },
            "description": "Toggle reaction. Adds if absent, removes if present. Returns action: added | removed."
          },
          "response": []
        },
        {
          "name": "List Reactions on Message",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reactions/message/{{messageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reactions",
                "message",
                "{{messageId}}"
              ]
            },
            "description": "List reactions on message grouped by emoji with count and `me` (whether current user reacted)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
